# Copy this file to .env before running Docker or local WSL startup.
# Never commit a real .env file or real API keys.

# API server
RAG_HOST=0.0.0.0
RAG_PORT=8000
RAG_UPLOAD_DIR=./uploads/
DEBUG_RAG_API=False
CONSOLE_JSON=False

# Auth
# Leave empty for local development so requests do not require JWT.
# Set a strong value in production, then send Authorization: Bearer <JWT>.
JWT_SECRET=

# Vector database
VECTOR_DB_TYPE=pgvector
POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword

# Docker full-stack mode uses DB_HOST=db and DB_PORT=5432.
# WSL local-API + Docker-DB mode should use DB_HOST=127.0.0.1 and DB_PORT=5433.
DB_HOST=db
DB_PORT=5432
PGVECTOR_CREATE_EXTENSION=True
PG_POOL_PRE_PING=True
PG_POOL_RECYCLE=-1
COLLECTION_NAME=docurag_dev

# Chunking
CHUNK_SIZE=1500
CHUNK_OVERLAP=100
EMBEDDING_BATCH_SIZE=500
EMBEDDING_MAX_QUEUE_SIZE=3

# Local HuggingFace embeddings
# BAAI/bge-m3 avoids paid OpenAI embedding quota and supports multilingual RAG.
EMBEDDINGS_PROVIDER=huggingface
EMBEDDINGS_MODEL=BAAI/bge-m3
HF_HOME=./data/huggingface
TOKENIZERS_PARALLELISM=false

# Optional OpenAI embeddings fallback.
# If you switch back to OpenAI, set EMBEDDINGS_PROVIDER=openai and fill the key.
# EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_CHUNK_SIZE=200
# RAG_OPENAI_API_KEY=
# RAG_OPENAI_BASEURL=
# RAG_OPENAI_PROXY=

# Optional: only OpenAI/Azure honor EMBEDDINGS_DIMENSIONS.
# Do not change dimensions on an existing pgvector collection.
# EMBEDDINGS_DIMENSIONS=1536

# Optional LLM generation layer for /rag/chat.
# BGE-M3 still handles embeddings/retrieval; the LLM only rewrites retrieved
# sources into a grounded answer with [source n] citations.
RAG_LLM_PROVIDER=disabled
# RAG_LLM_PROVIDER=openai_compatible
# RAG_LLM_MODEL=<your-chat-model>
# RAG_LLM_API_KEY=
# RAG_LLM_BASE_URL=
# RAG_LLM_TEMPERATURE=0
# RAG_LLM_MAX_OUTPUT_TOKENS=512
